node_modules/
jspm_packages/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/

# Build & Compilation Artifacts
dist/
build/
out/
.next/
cache/
artifacts/
typechain/
typechain-types/
broadcast/
flattened/

# Hardhat & Foundry
cache_hardhat/
.openzeppelin/unknown-*.json

# Coverage, Reports & Testing
coverage/
coverage.json
*.lcov
.nyc_output/
gasReporterOutput.json

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Database & Storage
*.sqlite
*.sqlite3
.api-store.json
*.api-store.json
*.db
dump.rdb
*.sql.gz

# Prisma
backend/prisma/migrations/**/.gitkeep


# Python (if AI/analytics services are used)
