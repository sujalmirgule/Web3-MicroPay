# ==============================================================================
# Web3 MicroPay - Environment Configuration Template (.env.example)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to `.env` for local development: `cp .env.example .env`
# 2. NEVER commit actual `.env` files, private keys, or API tokens to source control.
# 3. All variables are organized by subsystem and environment tier.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SYSTEM ENVIRONMENT & SERVER CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=development                       # Options: development | test | staging | production
PORT=4000                                 # Backend API server port
HOST=localhost                            # Backend API server host
LOG_LEVEL=debug                           # Options: error | warn | info | http | debug

# ------------------------------------------------------------------------------
# 2. CORS & FRONTEND CLIENT URLS
# ------------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:3000          # Allowed frontend origin(s) (comma-separated if multiple)
FRONTEND_URL=http://localhost:3000         # Canonical frontend URL for links/redirects

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (JWT / SIWE)
# ------------------------------------------------------------------------------
# JWT secret for backend session issuance (Off-chain session token)
JWT_SECRET=replace_with_a_secure_random_64_char_string_for_local_dev_only
JWT_EXPIRATION_HOURS=24
REFRESH_TOKEN_EXPIRATION_DAYS=7

# Sign-In With Ethereum (SIWE) / EIP-4361 domain configuration
SIWE_DOMAIN=localhost:3000
SIWE_STATEMENT="Sign in to Web3 MicroPay to authenticate your off-chain session."

# ------------------------------------------------------------------------------
# 4. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Target Relational Database (PostgreSQL recommended for production, MySQL/Postgres supported)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=web3_micropay_dev
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public

# Optional Redis Cache / Queue Store
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 5. BLOCKCHAIN & SMART CONTRACT CONFIGURATION
# ------------------------------------------------------------------------------
# Network Identification (Local Hardhat: 31337 | Sepolia: 11155111 | Polygon Amoy: 80002)
CHAIN_ID=31337
NETWORK_NAME=localhost

# Blockchain RPC Endpoints (HTTP and WebSocket for event subscription)
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_WS_RPC_URL=ws://127.0.0.1:8545

# Deployed Contract Addresses (Populated after deployment)
MICROPAY_CHANNEL_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
TOKEN_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000 # ERC-20 token address (USDC/USDT) or address(0) for native ETH/MATIC

# Relayer / Settlement Operator Wallet (Used by backend to submit batched settlements / vouchers)
# WARNING: NEVER USE A REAL PRIVATE KEY WITH VALUABLE ASSETS IN DEVELOPMENT OR COMMIT THIS.
RELAYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80 # Default Hardhat Account #0

# ------------------------------------------------------------------------------
# 6. AI SERVICE SUBSYSTEM CONFIGURATION
# ------------------------------------------------------------------------------
# AI is used ONLY for off-chain advisory: fraud heuristics, batching optimization, natural-language audit
AI_SERVICE_ENABLED=true
AI_PROVIDER=google-gemini                  # Options: google-gemini | openai | local-heuristic
AI_API_KEY=your_gemini_or_ai_api_key_here
AI_MODEL_NAME=gemini-1.5-flash
AI_MAX_TOKENS=1024
AI_REQUEST_TIMEOUT_MS=8000

# ------------------------------------------------------------------------------
# 7. NOTIFICATION & WEBHOOK SUBSYSTEM
# ------------------------------------------------------------------------------
# Webhook notification secrets and provider configuration
NOTIFICATION_DISPATCH_WORKERS=2
WEBHOOK_SIGNING_SECRET=replace_with_webhook_hmac_sha256_secret
EMAIL_SERVICE_ENABLED=false
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
NOTIFICATION_FROM_EMAIL=no-reply@web3micropay.internal
