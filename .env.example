# ──────────────────────────────────────────────────────────
#  Web3 MicroPay — Environment Configuration
#  Copy to .env and fill in values before starting.
#  NEVER commit .env to Git.
# ──────────────────────────────────────────────────────────

# ── System ──────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
HOST=localhost
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:3000

# ── Authentication ───────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_secure_random_64_char_dev_secret_key
SIWE_DOMAIN=localhost:3000

# ── Database (PostgreSQL) ────────────────────────────────────
# Docker: docker compose up -d postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/web3_micropay_dev

# ── Cache (Redis) ────────────────────────────────────────────
# Docker: docker compose up -d redis
REDIS_URL=redis://127.0.0.1:6379

# ── Blockchain & Contracts ───────────────────────────────────
CHAIN_ID=31337
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_WS_RPC_URL=ws://127.0.0.1:8545
# Set after: npm run deploy:local --workspace=contracts
MICROPAY_VAULT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
TOKEN_CONTRACT_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512

# ── Relayer ──────────────────────────────────────────────────
# LOCAL DEV ONLY — Hardhat Account #0.
# NEVER use this private key on mainnet or any funded wallet.
RELAYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ── AI Advisory Service ──────────────────────────────────────
AI_SERVICE_ENABLED=true
AI_PROVIDER=google-gemini
AI_API_KEY=your_gemini_api_key_here
AI_MODEL_NAME=gemini-1.5-flash

# ── Notifications ─────────────────────────────────────────────
WEBHOOK_SIGNING_SECRET=whsec_local_dev_test_secret_32char
