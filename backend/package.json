{
  "name": "@web3-micropay/backend",
  "version": "0.1.0",
  "description": "Backend API, Voucher Verification Engine, Relayer and Indexer for Web3 MicroPay",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "start": "node dist/index.js",
    "test": "mocha -r ts-node/register \"test/**/*.test.ts\" --timeout 10000 --exit",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema=prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema=prisma/schema.prisma",
    "db:seed": "ts-node --transpile-only src/db/seed.ts",
    "db:reset": "prisma migrate reset --schema=prisma/schema.prisma --force",
    "db:studio": "prisma studio --schema=prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@web3-micropay/shared": "*",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "ethers": "^6.13.1",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "jsonwebtoken": "^9.0.3",
    "pino": "^9.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/chai": "^4.3.16",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.14.2",
    "@types/pino": "^7.0.5",
    "chai": "^4.4.1",
    "mocha": "^10.4.0",
    "prisma": "^6.19.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
